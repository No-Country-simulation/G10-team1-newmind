# ==============================================================================
# NUEVAMENTE - VARIABLES DE ENTORNO
# ==============================================================================

# LLM Providers (Al menos una obligatoria)
GEMINI_API_KEY=tu_gemini_api_key_aqui
OPENAI_API_KEY=tu_openai_api_key_aqui
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# Modelo por defecto (ej. gemini-1.5-pro, gemini-1.5-flash, gpt-4o, etc.)
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Oracle Cloud Infrastructure (OCI Always Free)
# Usar OCI_CONFIG_FILE/OCI_CONFIG_PROFILE o los campos explícitos de autenticación definidos abajo.
# No guardar OCID reales, fingerprints, claves privadas ni namespaces reales en archivos versionados.
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_TENANCY_OCID=
OCI_REGION=us-ashburn-1
OCI_KEY_FILE=
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_BUCKET_DOCS=nuevamente-documentos-origen
OCI_BUCKET_OUTPUTS=nuevamente-contenidos-educativos

# Vector Store
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# App Configuration
APP_ENV=development
LOG_LEVEL=INFO
