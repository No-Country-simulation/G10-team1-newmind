# ==============================================================================
# NUEVAMENTE - VARIABLES DE ENTORNO
# ==============================================================================

# LLM Providers (Al menos una obligatoria)
GEMINI_API_KEY=tu_gemini_api_key_aqui
OPENAI_API_KEY=tu_openai_api_key_aqui
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# Modelo por defecto (ej. gemini-1.5-pro, gemini-1.5-flash, gpt-4o, etc.)
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Oracle Cloud Infrastructure (OCI Always Free)
OCI_USER_OCID=ocid1.user.oc1..aaaaaaa...
OCI_FINGERPRINT=aa:bb:cc:dd:...
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaa...
OCI_REGION=us-ashburn-1
OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_OBJECT_STORAGE_NAMESPACE=tu_tenancy_namespace
OCI_BUCKET_DOCS=nuevamente-documentos-origen
OCI_BUCKET_OUTPUTS=nuevamente-contenidos-educativos

# Vector Store
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# App Configuration
APP_ENV=development
LOG_LEVEL=INFO
